  "dataProtection": {
    "title": "Protection des Données & Politique de Confidentialité",
    "intro": "Sound Service Europe s'engage à protéger vos données personnelles et à respecter votre vie privée. Cette politique explique comment nous collectons, utilisons et protégeons vos informations conformément au Règlement Général sur la Protection des Données (RGPD).",
    "lastUpdated": "Dernière mise à jour",
    "section1": {
      "heading": "Responsable & Informations de Contact",
      "company": "Sound Service Musikanlagen-Vertriebsgesellschaft mbH",
      "address": "Moriz-Seeler-Straße 3, 12489 Berlin, Allemagne",
      "phone": "Téléphone",
      "fax": "Fax",
      "email": "E-mail",
      "dpoTitle": "Délégué à la Protection des Données",
      "dpoName": "Konrad Hartsch",
      "dpoContact": "datenschutz@sound-service.eu"
    },
    "section2": {
      "heading": "Collecte de Données de Visite du Site",
      "intro": "Lors de la visite à des fins d'information, le site collecte des données de journal de serveur, notamment:",
      "items": [
        "Pages visitées et horodatages",
        "Volume de données transféré",
        "Source de référence et informations sur le navigateur",
        "Détails du système d'exploitation",
        "Adresses IP anonymisées"
      ],
      "legalBasis": "Base juridique: Article 6(1)(f) RGPD (intérêt légitime pour la stabilité du site)"
    },
    "section3": {
      "heading": "Utilisation des Cookies",
      "text": "Le site utilise des cookies de session et persistants pour améliorer l'expérience utilisateur et simplifier les processus de commande. Les cookies stockent les paramètres du navigateur, les données de localisation et les informations IP.",
      "userControl": "Contrôle utilisateur: Les visiteurs peuvent configurer les préférences de cookies via les paramètres du navigateur (liens disponibles pour Internet Explorer, Firefox, Chrome, Safari, Opera).",
      "note": "Certains cookies sont essentiels au bon fonctionnement de la plateforme. La désactivation de ces cookies peut affecter votre capacité à utiliser certaines fonctionnalités."
    },
    "section4": {
      "heading": "Traitement des Informations de Contact",
      "text": "Les données personnelles soumises via les formulaires de contact sont collectées uniquement pour répondre aux demandes. Les données sont supprimées après la résolution de la question, dans le respect des exigences de conservation applicables.",
      "legalBasisA": "Base juridique: Article 6(1)(f) RGPD",
      "legalBasisB": "Article 6(1)(b) RGPD si lié au contrat"
    },
    "section5": {
      "heading": "Comptes Clients & Exécution des Contrats",
      "text": "Les données de compte permettent l'exécution du contrat. Les utilisateurs peuvent supprimer leurs comptes à tout moment en contactant le responsable. La conservation des données suit les exigences fiscales et commerciales."
    },
