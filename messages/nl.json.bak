    "aboutUs": {
      "modernLogistics": {
        "title": "Moderne Logistiek",
        "text": "Uitstekende voorraad voor heel Europa. Wij kennen onze merken en wij kennen uw klanten. Met ultramoderne opslag- en logistieke methoden distribueren wij uw producten naar zelfs de meest afgelegen uithoeken van Europa - en dat bliksemsnl."
      },
      "heartOfEurope": {
        "title": "In Het Hart Van Europa",
        "text": "Vanuit de wereldstad Berlijn zorgen wij voor de muzikale behoeften van retailers in heel Europa. Daarbij hechten wij groot belang aan het bieden van 360° alomvattende ondersteuning aan elke retailer. Wij lossen elk probleem op!"
      },
      "salesServiceTeams": {
        "title": "Verkoop- & Serviceteams",
        "text": "Als het om geluid gaat, weten wij waar we het over hebben. Ons internationaal personeel is hoogopgeleid en krijgt regelmatig training. Wij weten hoe we merken moeten opbouwen: Samen en met passie."
      }
    }
