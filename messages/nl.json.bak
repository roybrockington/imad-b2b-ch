    "section8": {
      "heading": "Gegevensbeveiliging",
      "intro": "Wij implementeren passende technische en organisatorische maatregelen om uw persoonlijke gegevens te beschermen tegen ongeautoriseerde toegang, wijziging, openbaarmaking of vernietiging. Deze maatregelen omvatten:",
      "encryption": {
        "title": "Versleuteling",
        "text": "Alle gegevens die tussen uw browser en onze servers worden overgedragen, worden versleuteld met SSL/TLS-technologie."
      },
      "accessControl": {
        "title": "Toegangscontrole",
        "text": "Strikte toegangscontroles zorgen ervoor dat alleen geautoriseerd personeel toegang heeft tot persoonlijke gegevens."
      },
      "audits": {
        "title": "Regelmatige Audits",
        "text": "Wij beoordelen en actualiseren regelmatig onze beveiligingspraktijken om de hoogste normen te handhaven."
      },
      "storage": {
        "title": "Veilige Opslag",
        "text": "Gegevens worden opgeslagen op beveiligde servers in conforme datacenters binnen de EU."
      }
    },
    "section9": {
      "heading": "Uw Rechten onder de AVG",
      "intro": "Als betrokkene heeft u de volgende rechten:",
      "access": {
        "title": "Recht op Inzage",
        "text": "Vraag een kopie op van de persoonlijke gegevens die wij over u bewaren."
      },
      "rectification": {
        "title": "Recht op Rectificatie",
        "text": "Vraag correctie van onjuiste of onvolledige gegevens."
      },
      "erasure": {
        "title": "Recht op Wissing",
        "text": "Vraag verwijdering van uw persoonlijke gegevens (onder voorbehoud van wettelijke verplichtingen)."
      },
      "restriction": {
        "title": "Recht op Beperking",
        "text": "Vraag beperking van de verwerking van uw persoonlijke gegevens."
      },
      "portability": {
        "title": "Recht op Gegevensoverdracht",
        "text": "Ontvang uw gegevens in een gestructureerd, gangbaar formaat."
      },
      "object": {
        "title": "Recht van Bezwaar",
        "text": "Maak bezwaar tegen de verwerking van uw persoonlijke gegevens voor marketingdoeleinden."
      }
    },
    "section10": {
      "heading": "Gegevensbewaring",
      "text": "Wij bewaren uw persoonlijke gegevens alleen zo lang als nodig is om de in dit beleid beschreven doeleinden te vervullen, te voldoen aan wettelijke verplichtingen, geschillen op te lossen en onze overeenkomsten af te dwingen."
    },
    "section11": {
      "heading": "Diensten van Derden",
      "text": "Wij kunnen uw gegevens delen met vertrouwde externe dienstverleners die ons helpen bij het exploiteren van ons platform, het verwerken van betalingen of het leveren van diensten. Deze partijen zijn contractueel verplicht uw gegevens te beschermen en deze alleen voor specifieke doeleinden te gebruiken."
    },
    "section12": {
      "heading": "Neem Contact Op met Onze Functionaris voor Gegevensbescherming",
